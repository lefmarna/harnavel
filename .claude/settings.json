{
  "permissions": {
    "allow": [
      "Bash(pnpm list:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm --version:*)",
      "Bash(mise run test:*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-edit.sh"
          }
        ]
      }
    ]
  }
}
