# アプリごとに100番ずつずらす。残りのポートと Compose 設定は mise run setup が書き換える。
DEV_PORT_BASE=20000
NGINX_PORT=20000
VITE_PORT=20001
MARIADB_PORT=20002
MAILPIT_SMTP_PORT=20003
MAILPIT_UI_PORT=20004
COMPOSE_PROJECT_NAME=
DEV_INFRA_PROJECT=
DEV_GIT_COMMON_DIR=

APP_NAME=app
APP_ENV=local
APP_KEY=
# 新規パスキーのユーザーハンドル用。APP_KEY と分けて管理し、本番では必須（TADR-0013）。
PASSKEYS_USER_HANDLE_SECRET=
APP_DEBUG=true
APP_URL="http://localhost:${NGINX_PORT}"

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

BCRYPT_ROUNDS=12

LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

ERROR_NOTIFIER_DISCORD_WEBHOOK_URL=

DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=root
DB_PASSWORD=password
DB_COLLATION=utf8mb4_general_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=null

CACHE_STORE=database

VITE_APP_NAME="Laravel App Template"

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${VITE_APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

GA_TRACKING_ID=
ADSENSE_PUBLISHER_ID=
