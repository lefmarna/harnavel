<IfModule mod_rewrite.c>
  RewriteEngine On

  # SSL更新(HTTP-01)の検証パスはホスト制限/HTTPS強制/public転送より先に通す
  RewriteRule ^\.well-known/acme-challenge(?:/|$) - [L]

  # developホスト以外はアクセス拒否
  RewriteCond %{HTTP_HOST} !^dev\.laravel-app-template\.com$ [NC]
  RewriteRule ^ - [F]

  # HTTPS強制
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://dev.laravel-app-template.com%{REQUEST_URI} [R=301,L]

  # public/ への転送（ループ防止付き）
  RewriteCond %{REQUEST_URI} !^/public/
  RewriteRule ^(.*)$ public/$1 [QSA,L]
</IfModule>

# mod_rewrite無効時はアクセス拒否（セキュリティ対策）
<IfModule !mod_rewrite.c>
  Require all denied
</IfModule>

# ドットファイルを拒否（.env 等）ただし .well-known は許可
<FilesMatch "^\.(?!well-known$)">
  Require all denied
</FilesMatch>
