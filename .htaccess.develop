<IfModule mod_rewrite.c>
  RewriteEngine On

  # 想定外のHost経由でアクセスさせないため
  RewriteCond %{HTTP_HOST} !^dev\.laravel-app-template\.com$ [NC]
  RewriteRule ^ - [F]

  # SSL証明書のHTTP-01検証を妨げないため
  RewriteRule ^\.well-known/acme-challenge(?:/|$) - [L]

  # .envや.gitなどの非公開ファイルを露出させないため
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F]

  RewriteCond %{HTTPS} off
  RewriteRule ^ https://dev.laravel-app-template.com%{REQUEST_URI} [R=301,L]

  # public/への再転送ループを防ぐため
  RewriteCond %{REQUEST_URI} !^/public/
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# セキュリティルールが適用できない状態で公開しないため
<IfModule !mod_rewrite.c>
  Require all denied
</IfModule>

# URL書き換えとは別にドットファイルを保護するため
<FilesMatch "^\.(?!well-known$)">
  Require all denied
</FilesMatch>

# SSL証明書のHTTP-01検証をBasic認証で妨げないため
<IfModule mod_rewrite.c>
  AuthUserFile "/home/{XSERVER_USER}/laravel-app-template.com/htpasswd/dev.laravel-app-template.com/.htpasswd"
  AuthName "Member Site"
  AuthType Basic

  <RequireAny>
    Require expr "%{REQUEST_URI} =~ m#^/\.well-known/acme-challenge(?:/|$)#"
    Require valid-user
  </RequireAny>
</IfModule>
