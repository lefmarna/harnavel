{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "resources/css/app.css",
    "functions": ["clsx", "cn", "cva"]
  },
  "ignorePatterns": [
    "resources/views/mail/**",
    "/boost.json",
    "resources/js/actions/**",
    "resources/js/routes/**",
    "resources/js/wayfinder/**",
    // Vendored: Laravel Boost and cc-sdd regenerate these wholesale.
    ".agents/skills/**",
    ".claude/skills/**",
    // Agent-facing: table padding consumes context without aiding review.
    ".kiro/**/*.md",
    "docs/generated/**/*.md",
    // Lock files
    "pnpm-lock.yaml",
    "storage/app/private/",
    "storage/app/public/",
    "storage/framework/",
    "storage/inertia-devtools/",
    "storage/logs/"
  ],
  "overrides": [
    {
      // A fragment that happens to parse as JS is silently rewritten to mean something else.
      "files": ["*.md"],
      "options": {
        "embeddedLanguageFormatting": "off"
      }
    }
  ]
}
