{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "singleAttributePerLine": false,
  "htmlWhitespaceSensitivity": "css",
  // Oxfmt defaults to 100. This repository formats to 80.
  "printWidth": 80,
  // Oxfmt defaults to true. Key order in package.json is not the formatter's call here.
  "sortPackageJson": false,
  // sortImports stays disabled (its default): eslint-plugin-import owns import order.
  "sortTailwindcss": {
    "stylesheet": "resources/css/app.css",
    "functions": ["clsx", "cn", "cva"]
  },
  "ignorePatterns": [
    "resources/js/components/ui/*",
    "resources/views/mail/*",
    "/boost.json",
    // Vendored: Laravel Boost and cc-sdd regenerate these wholesale.
    ".agents/skills/**/*.md",
    ".claude/skills/**/*.md",
    // Agent-facing: table padding consumes context without aiding review.
    ".kiro/**/*.md",
    "docs/generated/**/*.md",
    // Lock files
    "pnpm-lock.yaml",
    "storage/app/private/",
    "storage/app/public/",
    "storage/framework/",
    "storage/inertia-devtools/",
    "storage/logs/"
  ],
  "overrides": [
    {
      // A fragment that happens to parse as JS is silently rewritten to mean something else.
      "files": ["*.md"],
      "options": {
        "embeddedLanguageFormatting": "off"
      }
    },
    {
      "files": ["compose.yaml"],
      "options": {
        "singleQuote": false
      }
    }
  ]
}
