{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "fix": "pnpm lint:fix && pnpm format",
    "prepare": "lefthook install",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm lint:check",
    "lint:check": "oxlint . --type-aware",
    "lint:fix": "oxlint . --fix",
    "types:check": "tsc -p tsconfig.json --pretty && tsc -p resources/js/tsconfig.json --pretty false && tsc -p scripts/tsconfig.json --pretty false && tsc -p e2e/tsconfig.json --pretty false",
    "test:unit": "node --import tsx --test 'resources/js/**/*.test.{cts,mts,ts,tsx}' 'e2e/**/*.test.{cts,mts,ts}' 'scripts/**/*.test.{cts,mts,ts}'",
    "lint:docs": "node --import tsx scripts/lint-docs.ts",
    "test:deploy-lifecycle": "node --import tsx scripts/test-deploy-lifecycle.ts",
    "test:deploy-rsync-excludes": "node --import tsx scripts/test-deploy-rsync-excludes.ts",
    "test:toolchain-versions": "node --import tsx scripts/test-toolchain-versions.ts",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:all": "pnpm test:e2e:chromium && pnpm test:e2e:firefox && pnpm test:e2e:webkit",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "playwright:install": "playwright install --with-deps"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@inertiajs/react": "^3.0.0",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.475.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@inertiajs/vite": "^3.0.0",
    "@laravel/vite-plugin-wayfinder": "^0.1.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.13.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.0.1",
    "laravel-vite-plugin": "^3.0.0",
    "lefthook": "^2.1.10",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "^4.23.1",
    "typescript": "7.0.2",
    "vite": "^8.0.0",
    "yaml": "^2.9.0"
  }
}
