includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - bootstrap/providers.php
        - config/
        - database/
        - routes/
        - tests/Support/

    level: max

    # casts() の戻り値から属性の型を推論するために必要。
    parseModelCastsMethod: true
