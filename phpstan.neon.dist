includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - bootstrap/providers.php
        - config/
        - database/
        - routes/
        - tests/Support/

    level: max

    # Required for casts() return-type inference; the architecture test guards it.
    parseModelCastsMethod: true
