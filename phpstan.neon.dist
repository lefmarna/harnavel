includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - bootstrap/providers.php
        - config/
        - database/
        - routes/

    level: max

    # Larastan only reads the legacy $casts property by default; without this flag, casts()-based
    # datetime types silently degrade to string|null while analysis stays green (TADR-0007).
    parseModelCastsMethod: true
