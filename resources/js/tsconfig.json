{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // Unit tests execute in Node while importing modules written for the browser.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  // A child include replaces its parent's include, so tests must name shared declarations again.
  "include": ["**/*.d.ts", "**/*.test.cts", "**/*.test.mts", "**/*.test.ts", "**/*.test.tsx"],
  "exclude": ["../../node_modules"]
}
